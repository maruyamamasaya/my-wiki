---
import '../styles/global.css';
const defaultDescription = '気になったもの、好きなもの、あとでまた見たいものを集める個人的な図鑑';
const { title = 'My Wiki', description = defaultDescription, article = undefined } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <script is:inline>
      const savedTheme = localStorage.getItem('wiki-theme');
      const themes = ['aurora', 'paper', 'dark', 'sepia', 'forest', 'midnight'];
      document.documentElement.dataset.theme = themes.includes(savedTheme) ? savedTheme : 'aurora';
    </script>
    <title>{title}</title>
  </head>
  <body data-base={base} data-article-id={article?.uuid} data-article-title={article?.title}>
    <div class="aurora-environment" aria-hidden="true">
      <span class="aurora-light aurora-light-violet"></span>
      <span class="aurora-light aurora-light-cyan"></span>
      <span class="aurora-light aurora-light-blue"></span>
      <span class="aurora-light aurora-light-magenta"></span>
      <span class="aurora-sweep"></span>
    </div>
    <header class="site-header">
      <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">✦</span> My Wiki</a>
      <nav aria-label="メインナビゲーション">
        <a href={base}>ホーム</a><a href={`${base}search/`}>探す</a><a class="add-link" href={`${base}add/`}>気になったことを残す</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer><strong>My Wiki</strong></footer>
    <nav class="bottom-browser" aria-label="閲覧ナビゲーション">
      <div class="browser-actions">
        <a class="browser-button" href={base} aria-label="ホーム" title="ホーム">⌂</a>
        <button class="browser-button" id="nav-back" type="button" aria-label="戻る" title="戻る">←</button>
        <button class="browser-button" id="nav-forward" type="button" aria-label="進む" title="進む">→</button>
        <button class="browser-button" id="nav-reload" type="button" aria-label="更新" title="更新">↻</button>
        <a class="browser-button" href={`${base}search/`} aria-label="検索" title="検索">⌕</a>
        <div class="theme-control">
          <button class="browser-button" id="theme-toggle" type="button" aria-label="テーマを変更" title="テーマを変更" aria-haspopup="listbox" aria-expanded="false">◐</button>
          <div class="theme-menu" id="theme-menu" role="listbox" aria-label="表示テーマ" hidden>
            <button type="button" role="option" data-theme-value="aurora"><span class="theme-swatch swatch-aurora"></span><span>Living Aurora</span><span class="theme-check">✓</span></button>
            <button type="button" role="option" data-theme-value="paper"><span class="theme-swatch swatch-paper"></span><span>Paper</span><span class="theme-check">✓</span></button>
            <button type="button" role="option" data-theme-value="dark"><span class="theme-swatch swatch-dark"></span><span>Dark</span><span class="theme-check">✓</span></button>
            <button type="button" role="option" data-theme-value="sepia"><span class="theme-swatch swatch-sepia"></span><span>Sepia</span><span class="theme-check">✓</span></button>
            <button type="button" role="option" data-theme-value="forest"><span class="theme-swatch swatch-forest"></span><span>Forest</span><span class="theme-check">✓</span></button>
            <button type="button" role="option" data-theme-value="midnight"><span class="theme-swatch swatch-midnight"></span><span>Midnight</span><span class="theme-check">✓</span></button>
          </div>
        </div>
      </div>
      <div class="address-bar" aria-label="現在地"><span aria-hidden="true">◉</span><span id="current-location"></span></div>
    </nav>
    <script>
      const body = document.body;
      type ReadingItem = { uuid: string; title: string; url: string; count: number; lastViewed: number };
      const locationLabel = document.querySelector('#current-location');
      if (locationLabel) locationLabel.textContent = decodeURIComponent(location.pathname);
      document.querySelector('#nav-back')?.addEventListener('click', () => history.back());
      document.querySelector('#nav-forward')?.addEventListener('click', () => history.forward());
      document.querySelector('#nav-reload')?.addEventListener('click', () => location.reload());
      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const themeMenu = document.querySelector<HTMLElement>('#theme-menu');
      const themeOptions = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-value]')];
      const syncThemeMenu = () => {
        const activeTheme = document.documentElement.dataset.theme;
        themeOptions.forEach((option) => {
          const selected = option.dataset.themeValue === activeTheme;
          option.setAttribute('aria-selected', String(selected));
        });
      };
      const closeThemeMenu = () => {
        if (!themeMenu || !themeToggle) return;
        themeMenu.hidden = true;
        themeToggle.setAttribute('aria-expanded', 'false');
      };
      themeToggle?.addEventListener('click', () => {
        if (!themeMenu) return;
        const willOpen = themeMenu.hidden;
        themeMenu.hidden = !willOpen;
        themeToggle.setAttribute('aria-expanded', String(willOpen));
        if (willOpen) { syncThemeMenu(); themeOptions.find((option) => option.getAttribute('aria-selected') === 'true')?.focus(); }
      });
      themeOptions.forEach((option) => option.addEventListener('click', () => {
        const next = option.dataset.themeValue;
        if (!next) return;
        document.documentElement.dataset.theme = next;
        localStorage.setItem('wiki-theme', next);
        syncThemeMenu();
        closeThemeMenu();
        themeToggle?.focus();
      }));
      document.addEventListener('click', (event) => {
        if (!(event.target as Element).closest('.theme-control')) closeThemeMenu();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { closeThemeMenu(); themeToggle?.focus(); }
      });
      syncThemeMenu();

      const articleId = body.dataset.articleId;
      const articleTitle = body.dataset.articleTitle;
      if (articleId && articleTitle) {
        try {
          const key = 'wiki-reading-history';
          const items = JSON.parse(localStorage.getItem(key) || '[]') as ReadingItem[];
          const previous = items.find((item) => item.uuid === articleId);
          const current = { uuid: articleId, title: articleTitle, url: location.pathname, count: (previous?.count || 0) + 1, lastViewed: Date.now() };
          localStorage.setItem(key, JSON.stringify([current, ...items.filter((item) => item.uuid !== articleId)].slice(0, 50)));
        } catch { /* localStorageが使えない環境では履歴を記録しない */ }
      }
    </script>
  </body>
</html>
