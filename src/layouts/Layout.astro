---
import '../styles/global.css';
const { title = 'Knowledge Wiki', description = '個人用Knowledge Wiki' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}><span class="brand-mark">K</span> Knowledge Wiki</a>
      <nav aria-label="メインナビゲーション">
        <a href={base}>Home</a><a href={`${base}search/`}>Search</a><a class="add-link" href={`${base}add/`}>＋ 追加</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Markdown is the source of truth · UUID keeps every article stable</footer>
  </body>
</html>
