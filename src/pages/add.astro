---
import Layout from '../layouts/Layout.astro';
---
<Layout title="気になったことを残す · My Wiki">
  <section class="narrow-page"><p class="eyebrow">QUICK NOTE</p><h1>気になったことを残す</h1><p class="lead">数行のメモでも大丈夫です。「これ面白い」と思った気持ちが新しいうちに、気軽に置いておきましょう。</p><p class="muted">入力内容はGitHubで確認し、記事追加のPull Requestとして安全に追加されます。WikiがGitHubの認証情報を保持することはありません。</p>
    <div class="panel form-grid"><label>タイトル<input id="title" placeholder="本文のH1から自動検出" /></label><label>置き場所<select id="folder"><option>misc</option><option>music</option><option>games</option><option>science</option><option>history</option><option>computer</option><option>ai</option><option>coffee</option><option>gadgets</option><option>places</option><option>media</option></select></label><label>メモ本文<span class="field-hint">短い文章や箇条書きだけでもOK</span><textarea id="body" placeholder="# タイトル\n\n面白いと思ったこと、あとで見返したいこと"></textarea></label><div><strong>つながり</strong><div id="links" class="link-check muted">ほかのページへのWiki Linkはまだありません。</div></div><div class="actions"><button id="submit" class="button">GitHubで追加を確認</button><button id="download" class="button secondary">Markdownを保存</button><button id="copy" class="button secondary">完成形をコピー</button></div><p class="meta">GitHubでIssueを送信すると、内容を検証してPull Requestを作成します。あとはPRをマージすれば公開されます。</p><p id="message" class="meta" aria-live="polite"></p></div>
  </section>
  <script>
    // @ts-nocheck
    import { dateInJapan } from '../lib/datetime';
    const title=document.querySelector('#title'), body=document.querySelector('#body'), folder=document.querySelector('#folder'), links=document.querySelector('#links'), message=document.querySelector('#message');
    const data=await fetch(`${import.meta.env.BASE_URL}knowledge-index.json`).then(r=>r.json());
    const known=new Map(); Object.values(data.articles).forEach(a=>[a.title,...a.aliases].forEach(v=>known.set(v.toLocaleLowerCase(),a)));
    body.addEventListener('input',()=>{ if(!title.value){const h1=body.value.match(/^#\s+(.+)$/m);if(h1)title.value=h1[1].trim()} const found=[...new Set([...body.value.matchAll(/\[\[([^\]|#]+)/g)].map(m=>m[1].trim()))]; links.innerHTML=found.length?found.map(v=>`<div class="${known.has(v.toLocaleLowerCase())?'status-ok':'status-warn'}">${known.has(v.toLocaleLowerCase())?'✓':'?'} [[${escapeHtml(v)}]]</div>`).join(''):'ほかのページへのWiki Linkはまだありません。';});
    const escapeHtml=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const build=()=>{const now=dateInJapan(), id=crypto.randomUUID(), safe=(title.value||'untitled').trim(), slug=safe.toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu,'-').replace(/^-|-$/g,'')||id; const text=`---\nid: ${id}\ntitle: ${JSON.stringify(safe)}\naliases: []\ncreated: ${now}\nupdated: ${now}\ntags: []\n---\n\n${body.value.trim()}\n`; return {text,name:`${folder.value}/${slug}.md`}};
    const valid=()=>{if(!title.value.trim()||!body.value.trim()){message.textContent='タイトルと本文を入力してください。';return false}return true};
    document.querySelector('#submit').addEventListener('click',()=>{if(!valid())return;const v=build(), payload=btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify({version:1,path:v.name,markdown:v.text}))));const issueBody=`Wikiの記事追加リクエストです。送信後、Actionsが内容を検証してPull Requestを作成します。\n\n- 保存先: \`${v.name}\`\n- タイトル: ${title.value.trim()}\n\n<!-- wiki-article-data:${payload} -->`;const url=new URL('https://github.com/maruyamamasaya/my-wiki/issues/new');url.searchParams.set('title',`[Article] ${title.value.trim()}`);url.searchParams.set('body',issueBody);window.open(url,'_blank','noopener,noreferrer');message.textContent='GitHubで内容を確認し、「Submit new issue」を押してください。';});
    document.querySelector('#download').addEventListener('click',()=>{if(!valid())return;const v=build(),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([v.text],{type:'text/markdown'}));a.download=v.name.split('/').pop();a.click();URL.revokeObjectURL(a.href);message.textContent=`${v.name} 用のMarkdownを作成しました。`;});
    document.querySelector('#copy').addEventListener('click',async()=>{if(!valid())return;await navigator.clipboard.writeText(build().text);message.textContent='Front Matter付きMarkdownをコピーしました。';});
  </script>
</Layout>
