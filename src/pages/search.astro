---
import Layout from '../layouts/Layout.astro';
---
<Layout title="気ままに探す · My Wiki">
  <section class="narrow-page"><p class="eyebrow">SEARCH</p><h1>気ままに探す</h1><p class="lead">タイトルを忘れても、覚えている言葉やタグから見つけられます。</p><input id="query" class="search-input" type="search" placeholder="タイトル、タグ、本文から探す" autofocus /><div id="results" class="search-results" aria-live="polite">気になる言葉を入力してください。</div></section>
  <script>
    // @ts-nocheck
    const input = document.querySelector('#query'); const results = document.querySelector('#results');
    const data = await fetch(`${import.meta.env.BASE_URL}knowledge-index.json`).then(r => r.json());
    const articles = Object.values(data.articles); const params = new URLSearchParams(location.search); const initial = params.get('q') || params.get('tag') || '';
    const render = () => { const q = input.value.trim().toLocaleLowerCase(); const found = q ? articles.filter(a => [a.title,...a.aliases,...a.tags,a.body].join('\n').toLocaleLowerCase().includes(q)) : [];
      results.innerHTML = found.length ? `<ul class="article-list">${found.map(a => `<li><a href="${import.meta.env.BASE_URL}articles/${a.uuid}/">${escapeHtml(a.title)}</a><div class="meta">${a.tags.map(tag => `#${escapeHtml(tag)}`).join(' ')} · ${a.updated}</div></li>`).join('')}</ul>` : q ? '一致するものはありませんでした。別の言葉でも探してみてください。' : '気になる言葉を入力してください。'; };
    const escapeHtml = s => String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    input.value=initial; input.addEventListener('input',render); render();
  </script>
</Layout>
