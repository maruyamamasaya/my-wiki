---
import Layout from '../layouts/Layout.astro';
import index from '../generated/knowledge-index.json';
import { articleUrl } from '../lib/wiki';
import type { KnowledgeIndex } from '../../scripts/indexer';
const knowledgeIndex = index as KnowledgeIndex;
const articles = Object.values(knowledgeIndex.articles).sort((a,b) => b.updated.localeCompare(a.updated));
const tagCounts = new Map<string, number>();
articles.forEach((article) => article.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const tags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const excerpt = (body: string, title: string) => {
  const text = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/^\s*(?:---+|___+|\*\*\*+)\s*$/gm, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\[\[([^\]|#]+)(?:#[^\]|]+)?(?:\|([^\]]+))?\]\]/g, (_match, target, label) => label || target)
    .replace(/^\s{0,3}#{1,6}\s+/gm, '')
    .replace(/^\s*(?:[-*+>]|\d+\.)\s+/gm, '')
    .replace(/[*_~`|]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  const withoutDuplicateTitle = text.startsWith(title) ? text.slice(title.length).trim() : text;
  return withoutDuplicateTitle.length > 120 ? `${withoutDuplicateTitle.slice(0, 120).trimEnd()}…` : withoutDuplicateTitle;
};
---
<Layout title="My Wiki" description="気になったもの、好きなもの、あとでまた見たいものを集める個人的な図鑑">
  <header class="home-heading">
    <h1>My Wiki</h1>
    <form class="home-search" action={`${import.meta.env.BASE_URL}search/`}><label class="sr-only" for="home-query">Wikiを検索</label><input id="home-query" name="q" type="search" placeholder="タイトル、タグ、本文から探す" /><button class="button" type="submit">検索</button></form>
  </header>

  <div class="home-layout">
    <section class="wiki-section articles-section">
      <div class="section-heading"><h2>すべての記事</h2><span class="section-count">{articles.length}件</span></div>
      <ul class="article-index">{articles.map((article, articleIndex) => <li hidden={articleIndex >= 50}><a href={articleUrl(article.uuid)}><div class="article-index-heading"><strong>{article.title}</strong><time datetime={article.updated}>{article.updated}</time></div><p>{excerpt(article.body, article.title) || '本文はまだありません。'}</p></a></li>)}</ul>
      <nav class="article-pagination" aria-label="記事一覧のページ送り">
        <button id="page-previous" type="button">前へ</button>
        <span id="page-position" aria-live="polite">1–{Math.min(50, articles.length)} / {articles.length}件</span>
        <button id="page-next" type="button" disabled={articles.length <= 50}>次へ</button>
      </nav>
    </section>

    <aside class="home-aside">
      <section class="wiki-section local-reading" id="frequent-section">
        <div class="section-heading"><h2>最近よく見ているもの</h2></div>
        <ol id="frequent-articles" class="compact-article-list"></ol>
        <p id="frequent-empty" class="empty-note">何度か読み返したページが、ここに並びます。</p>
      </section>
      <section class="wiki-section genres-section">
        <div class="section-heading"><h2>タグから探す</h2></div>
        <div class="genre-tags">{tags.map(([tag, count]) => <a class="genre-tag" href={`${import.meta.env.BASE_URL}search/?tag=${encodeURIComponent(tag)}`}><span>#{tag}</span><small>{count}</small></a>)}</div>
      </section>
    </aside>
  </div>
  <script>
    type ReadingItem = { uuid: string; title: string; url: string; count: number; lastViewed: number };
    const key = 'wiki-reading-history';
    const base = document.body.dataset.base || '/';
    const readItems = (): ReadingItem[] => {
      try { return JSON.parse(localStorage.getItem(key) || '[]') as ReadingItem[]; } catch { return []; }
    };
    const safeUrl = (value: string) => {
      try { const url = new URL(value, location.origin); return url.origin === location.origin && url.pathname.startsWith(base) ? url.pathname : base; }
      catch { return base; }
    };
    const fill = (listId: string, sectionId: string, items: ReadingItem[], showCount = false) => {
      const list = document.querySelector(`#${listId}`);
      const section = document.querySelector<HTMLElement>(`#${sectionId}`);
      if (!list || !section || !items.length) return;
      list.replaceChildren(...items.map((item) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = safeUrl(item.url); link.textContent = item.title;
        li.append(link);
        if (showCount) { const count = document.createElement('span'); count.textContent = `${item.count}回`; li.append(count); }
        return li;
      }));
      section.hidden = false;
    };
    const renderReadingData = () => {
      const items = readItems();
      const frequent = [...items].filter((item) => item.count > 1).sort((a, b) => b.count - a.count || b.lastViewed - a.lastViewed).slice(0, 5);
      fill('frequent-articles', 'frequent-section', frequent, true);
      if (frequent.length) document.querySelector('#frequent-empty')?.remove();
    };
    const articleItems = [...document.querySelectorAll<HTMLElement>('.article-index > li')];
    const previousButton = document.querySelector<HTMLButtonElement>('#page-previous');
    const nextButton = document.querySelector<HTMLButtonElement>('#page-next');
    const pagePosition = document.querySelector<HTMLElement>('#page-position');
    const pageSize = 50;
    const totalPages = Math.max(1, Math.ceil(articleItems.length / pageSize));
    const requestedPage = Number(new URLSearchParams(location.search).get('page') || '1');
    let currentPage = Number.isInteger(requestedPage) ? Math.min(Math.max(requestedPage, 1), totalPages) : 1;
    const renderArticlePage = (page: number, updateHistory = false) => {
      currentPage = Math.min(Math.max(page, 1), totalPages);
      const start = (currentPage - 1) * pageSize;
      const end = Math.min(start + pageSize, articleItems.length);
      articleItems.forEach((item, index) => { item.hidden = index < start || index >= end; });
      if (previousButton) previousButton.disabled = currentPage === 1;
      if (nextButton) nextButton.disabled = currentPage === totalPages;
      if (pagePosition) pagePosition.textContent = articleItems.length ? `${start + 1}–${end} / ${articleItems.length}件` : '0件';
      if (updateHistory) {
        const url = new URL(location.href);
        if (currentPage === 1) url.searchParams.delete('page'); else url.searchParams.set('page', String(currentPage));
        history.pushState({ page: currentPage }, '', url);
        document.querySelector('.articles-section')?.scrollIntoView({ behavior: 'smooth' });
      }
    };
    previousButton?.addEventListener('click', () => renderArticlePage(currentPage - 1, true));
    nextButton?.addEventListener('click', () => renderArticlePage(currentPage + 1, true));
    addEventListener('popstate', () => {
      const page = Number(new URLSearchParams(location.search).get('page') || '1');
      renderArticlePage(Number.isInteger(page) ? page : 1);
    });
    renderReadingData();
    renderArticlePage(currentPage);
  </script>
</Layout>
